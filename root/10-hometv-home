#!/bin/sh
# Homebrew Channel start-up hook (/var/lib/webosbrew/init.d/10-hometv-home): makes HomeTV LG's Home, in memory only. A
# restart without this hook (an LG update that ends root, or Homebrew Channel's failsafe start) leaves LG's Home as it
# was. "Use LG's Home" (undo-home.sh) removes this hook and writes DISABLE in the HomeTV folder, which it honours too.
# HomeTV uninstalled in Homebrew Channel leaves this hook behind: it then does nothing. From lasharor's
# 10-cleanyourtv-home (MIT), the mount way only.
. "$(dirname "$(readlink -f "$0")")/lib.sh"
[ -e "$D/DISABLE" ] && exit 0
# The hook ran this start (HomeTV's "root ended" notice reads it; written before any check that may stop the takeover)
b=$(cat "$BOOT_ID" 2>/dev/null) && [ -n "$b" ] && echo "$b" > "$STARTED" || say "home: couldn't note this start in $STARTED"
[ -f "$APP/index.html" ] || { say "home: HomeTV isn't installed; LG's Home stays"; exit 0; }
home=$(node "$D/decide.js" kind "$D/backup/home-appinfo.orig.json")
if [ "$(node "$D/decide.js" takeover "$home")" != mount ]; then
  say "home: LG's Home here is '$home'; HomeTV only takes over the flutter or web Home; LG's Home stays"
  exit 0
fi
sh "$D/stage-home.sh" || exit 0
# HomeTV's service writes the heartbeat the watchdog reads, so it must see the real /tmp: elevated at every start (it
# changes nothing when already done; an update of HomeTV re-registers the service jailed)
if [ -f "$ELEVATE" ]; then
  node "$ELEVATE" "$APP_ID.service" "$APP_ID" >/dev/null 2>&1 || say "home: elevate-service failed for $APP_ID.service"
else
  say "home: no elevate-service ($ELEVATE); the watchdog may give LG's Home back"
fi
pgrep -f "[h]ometv/watchdog.sh" >/dev/null || (sh "$D/watchdog.sh" </dev/null >/dev/null 2>&1 &)
if replaced; then
  say "home: already HomeTV (the page was refreshed in place)"
  exit 0
fi
say "home: mounting HomeTV over LG's Home, restarting sam"
mount --bind "$D/home-overlay" "$H" || { say "home: the mount failed; LG's Home stays"; exit 0; }
(sleep 3; pkill -9 -f /usr/palm/applications/airplay/LunaExecutable) </dev/null >/dev/null 2>&1 &
systemctl restart sam
(
  for i in $(seq 1 60); do systemctl is-active sam >/dev/null 2>&1 && break; sleep 2; done
  sh "$D/after-sam.sh"
  sleep 8
  # after the restart nothing is on screen; open Home unless the TV is already on an input or an app
  case "$(foreground)" in
    ""|com.webos.app.home)
      pkill -f "[a]pp-id=com.webos.app.home"; sleep 2
      luna_send -n 1 -w 10000 -f luna://com.webos.applicationManager/launch '{"id":"com.webos.app.home"}' >/dev/null ;;
  esac
) </dev/null >/dev/null 2>&1 &
exit 0
